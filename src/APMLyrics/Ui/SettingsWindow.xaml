<Window x:Class="APMLyrics.Ui.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:APMLyrics.Ui"
        Title="APM Lyrics settings"
        Width="520" MinWidth="480" Height="560"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        Icon="Assets/app.ico">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar navigation, in the style of modern Windows settings. -->
        <ListBox x:Name="Nav" Grid.Column="0" SelectionMode="Single" Margin="8"
                 SelectedIndex="0">
            <ListBoxItem Content="Appearance" Tag="AppearancePage"/>
            <ListBoxItem Content="Colors" Tag="ColorsPage"/>
            <ListBoxItem Content="Behaviour" Tag="BehaviourPage"/>
            <ListBoxItem Content="About" Tag="AboutPage"/>
        </ListBox>

        <Grid Grid.Column="1" Margin="8,8,16,16">
            <!-- Appearance -->
            <StackPanel x:Name="AppearancePage" Margin="0,4,0,0">
                <TextBlock Text="Display mode" FontWeight="SemiBold"/>
                <RadioButton x:Name="ModeMulti" Content="Multi-line (previous, current, next)" GroupName="mode" Margin="0,6,0,0"/>
                <RadioButton x:Name="ModeSingle" Content="Single-line" GroupName="mode" Margin="0,4,0,12"/>

                <TextBlock Text="Neighbour lines (0 to 4)" FontWeight="SemiBold"/>
                <Slider x:Name="Radius" Minimum="0" Maximum="4" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,6,0,12"/>

                <TextBlock Text="Font family" FontWeight="SemiBold"/>
                <ComboBox x:Name="FontFamilyPicker" Margin="0,6,0,12"/>

                <CheckBox x:Name="LockFont" Content="Lock font size (resizing no longer changes it)" Margin="0,0,0,6"/>
                <TextBlock x:Name="FontSizeLabel" Text="Font size (10 to 96)" FontWeight="SemiBold"/>
                <Slider x:Name="FontSizeSlider" Minimum="10" Maximum="96" TickFrequency="2" IsSnapToTickEnabled="True" Margin="0,6,0,12"/>

                <Border Background="#222" CornerRadius="6" Padding="8" Margin="0,4,0,0">
                    <ui:LyricPanel x:Name="Preview" Height="110"/>
                </Border>
            </StackPanel>

            <!-- Colors -->
            <StackPanel x:Name="ColorsPage" Visibility="Collapsed">
                <TextBlock Text="Current line colour" FontWeight="SemiBold"/>
                <TextBox x:Name="CurrentLineColorBox" ToolTip="Colour name or #RRGGBB" Margin="0,6,0,12"/>

                <TextBlock Text="Text colour (neighbour lines)" FontWeight="SemiBold"/>
                <TextBox x:Name="TextColorBox" ToolTip="Colour name or #RRGGBB" Margin="0,6,0,12"/>

                <TextBlock Text="Backdrop colour" FontWeight="SemiBold"/>
                <TextBox x:Name="BackdropColorBox" ToolTip="Colour name or #RRGGBB" Margin="0,6,0,12"/>

                <TextBlock Text="Backdrop opacity (higher is more readable)" FontWeight="SemiBold"/>
                <Slider x:Name="Backdrop" Minimum="0" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" Margin="0,6,0,12"/>

                <TextBlock Text="Neighbour line opacity (0 to 1)" FontWeight="SemiBold"/>
                <Slider x:Name="NeighbourOpacity" Minimum="0" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" Margin="0,6,0,12"/>

                <CheckBox x:Name="Dim" Content="Dim the neighbouring lines" Margin="0,0,0,12"/>

                <Border Background="#222" CornerRadius="6" Padding="8">
                    <ui:LyricPanel x:Name="ColorPreview" Height="110"/>
                </Border>
            </StackPanel>

            <!-- Behaviour -->
            <StackPanel x:Name="BehaviourPage" Visibility="Collapsed">
                <TextBlock Text="Click-through (the tray menu can undo this)" FontWeight="SemiBold"/>
                <CheckBox x:Name="Through" Margin="0,6,0,12"/>

                <TextBlock Text="The overlay always stays above the taskbar: dropping it over the"
                           TextWrapping="Wrap"/>
                <TextBlock Text="taskbar lifts it back on top automatically." TextWrapping="Wrap"
                           Foreground="Gray"/>
            </StackPanel>

            <!-- About -->
            <StackPanel x:Name="AboutPage" Visibility="Collapsed">
                <Image Source="/Assets/app.ico" Width="64" Height="64" Margin="0,12,0,8"
                       HorizontalAlignment="Left"/>
                <TextBlock Text="APM Lyrics" FontSize="20" FontWeight="Bold"/>
                <TextBlock x:Name="VersionText" Foreground="Gray" Margin="0,2,0,12"/>
                <TextBlock Text="Synced lyrics for Apple Music, floating on top of everything else."
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
